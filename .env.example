# =============================================================================
# Yojana Sahayak — environment configuration
# Copy to `.env` in the repo root and fill in the blanks. NEVER commit `.env`.
# Every key read by backend/app/config.py must be listed here (AGENTS.md R5).
# Relative paths are resolved from backend/ (where uvicorn and ingestion run).
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# dev | test | prod — affects logging defaults and startup checks
APP_ENV=dev
# Port uvicorn listens on (keep in sync with the frontend Vite proxy)
API_PORT=8000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = include the `debug` block (intent, sources, scores, timings) in chat responses
DEBUG_PIPELINE=true

# -----------------------------------------------------------------------------
# LLM
# Model names change often on free tiers — check the current model names on the
# Groq and Google AI Studio consoles before filling these in.
# -----------------------------------------------------------------------------
# Primary provider: groq | gemini | mock (mock = deterministic, no key needed)
LLM_PROVIDER=groq
# Used when the primary fails or times out: gemini | groq | none
LLM_FALLBACK_PROVIDER=gemini
# Groq model for answer generation (larger, better quality)
LLM_MODEL=
# Groq model for query understanding (small and fast)
LLM_FAST_MODEL=
# Gemini model used as fallback / per-language route
GEMINI_MODEL=
# Per-language provider override, format lang:provider,lang:provider
LLM_PROVIDER_BY_LANG=ta:gemini,bn:gemini
# Timeout for one LLM call, in seconds
LLM_TIMEOUT_S=12
# Low temperature keeps answers close to the sources
LLM_TEMPERATURE=0.1
# Groq API key (free tier) — https://console.groq.com
GROQ_API_KEY=
# Gemini API key (free tier) — https://aistudio.google.com
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# RAG (start values — final tuned values are recorded in docs/DECISIONS.md)
# -----------------------------------------------------------------------------
# Sentence-transformers model for query and passage embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Results from the search filtered by the detected scheme hints
RAG_TOP_K_FILTERED=6
# Results from the unfiltered search (protects against a wrong hint)
RAG_TOP_K_UNFILTERED=4
# Best score (1 - cosine distance) below this → "not found in official documents", no LLM call
RAG_MIN_SCORE=0.78
# Maximum chunks sent to the LLM as context
RAG_CONTEXT_CHUNKS=4
# Maximum context size in tokens
RAG_CONTEXT_TOKENS=2500
# Number of previous turns sent for follow-up understanding
CHAT_HISTORY_TURNS=4
# Answer cache time-to-live, in seconds
ANSWER_CACHE_TTL_S=3600

# -----------------------------------------------------------------------------
# Paths (relative to backend/)
# -----------------------------------------------------------------------------
# Root of the data folder (schemes JSON, raw PDFs)
DATA_DIR=../data
# Chroma persistent directory (generated by ingestion, gitignored)
VECTORSTORE_DIR=../data/vectorstore
# SQLite database file (conversations, messages, feedback — never profiles)
SQLITE_PATH=../data/app.db

# -----------------------------------------------------------------------------
# Features
# -----------------------------------------------------------------------------
# true = persist the answer cache so rehearsed demo answers survive restarts
DEMO_MODE=false
# none | bhashini — machine translation adapter (off by default, see ADR-005)
TRANSLATION_PROVIDER=none
# Bhashini credentials (only if TRANSLATION_PROVIDER=bhashini)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Max chat requests per client per minute
RATE_LIMIT_PER_MIN=20

# -----------------------------------------------------------------------------
# Frontend — put these in frontend/.env.local (Vite only reads env from frontend/)
# -----------------------------------------------------------------------------
# Base path for API calls (proxied to the backend by Vite in dev)
# VITE_API_BASE=/api/v1
# true = lib/api-client.ts returns responses from lib/mocks (no backend needed)
# VITE_USE_MOCKS=false

# -----------------------------------------------------------------------------
# Telegram bot (bots/telegram, optional)
# -----------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Backend API base URL the bot calls
BOT_BACKEND_URL=http://localhost:8000/api/v1
